{
  "defaultProvider": "github-copilot",
  "defaultModel": "gpt-6-astra",
  "defaultThinkingLevel": "low",
  "subagents": {
    "agentOverrides": {
      "easy": { "model": "github-copilot/gpt-5.6-luna", "thinking": "medium" },
      "medium": { "model": "github-copilot/gpt-5.6-luna", "thinking": "high" },
      "hard": { "model": "github-copilot/gpt-5.6-sol", "thinking": "medium" },
      "very-hard": { "model": "github-copilot/gpt-6-astra", "thinking": "low" }
    },
    "modelScope": {
      "enforce": true,
      "strict": true,
      "allow": [
        "github-copilot/gpt-5.6-luna",
        "github-copilot/gpt-5.6-sol",
        "github-copilot/gpt-6-astra"
      ]
    },
    "maxSubagentDepth": 1,
    "globalConcurrencyLimit": 4,
    "maxSubagentSpawnsPerRun": 16
  },
  "packages": ["npm:pi-subagents"]
}
